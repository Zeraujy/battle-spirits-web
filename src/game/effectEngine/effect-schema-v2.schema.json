{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaihou.local/schema/effect-schema-v2.json",
  "title": "Battle Spirits KAIHOU Effect Schema v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "trigger",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "object",
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "whenSummoned",
            "whenDeployed",
            "whenAttacks",
            "whenBlocks",
            "whenBattles",
            "whenBlocked",
            "whenDestroyed",
            "wouldLoseLife",
            "wouldBeDestroyed",
            "beforeBattleResolution",
            "afterBattleResolution",
            "lifeDecreased",
            "magicMain",
            "magicFlash",
            "burstLifeDecrease",
            "burstOpponentHandIncrease",
            "burst",
            "mirage",
            "continuous",
            "startStep",
            "coreStep",
            "drawStep",
            "refreshStep",
            "mainStep",
            "attackStep",
            "endStep",
            "cardMoved",
            "coreMoved",
            "afterUltimateTrigger",
            "ultimateTriggerHit",
            "ultimateTriggerGuard",
            "ultimateTriggerResolved",
            "triggerCounter",
            "xuTriggerHit",
            "criticalHit"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "source",
            "controllerField",
            "controllerHand",
            "controllerTrash"
          ],
          "default": "source"
        },
        "eventPlayer": {
          "type": "string",
          "enum": [
            "self",
            "opponent",
            "any"
          ],
          "default": "any"
        }
      },
      "additionalProperties": true
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      },
      "default": []
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "selector": {
            "$ref": "#/$defs/targetSelector"
          },
          "duration": {
            "$ref": "#/$defs/duration"
          },
          "modifier": {
            "$ref": "#/$defs/modifier"
          }
        },
        "additionalProperties": true
      },
      "default": []
    }
  },
  "additionalProperties": true,
  "$defs": {
    "targetSelector": {
      "type": "object",
      "properties": {
        "owner": {
          "enum": [
            "self",
            "opponent",
            "any"
          ]
        },
        "zone": {
          "type": "string"
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cardType": {
          "type": "string"
        },
        "cardTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color": {
          "type": "string"
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "family": {
          "type": "string"
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbol": {
          "type": "string"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimumCost": {
          "type": "number"
        },
        "maximumCost": {
          "type": "number"
        },
        "minimumBP": {
          "type": "number"
        },
        "maximumBP": {
          "type": "number"
        },
        "minimumLevel": {
          "type": "number"
        },
        "maximumLevel": {
          "type": "number"
        },
        "state": {
          "enum": [
            "exhausted",
            "refreshed"
          ]
        },
        "braved": {
          "type": "boolean"
        },
        "combined": {
          "type": "boolean"
        },
        "hasSoulCore": {
          "type": "boolean"
        },
        "excludeSource": {
          "type": "boolean"
        },
        "includeCombined": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "condition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "player": {
          "enum": [
            "self",
            "opponent"
          ]
        },
        "value": {},
        "operator": {
          "type": "string"
        },
        "equals": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "atLeast": {
          "type": "number"
        },
        "atMost": {
          "type": "number"
        },
        "selector": {
          "$ref": "#/$defs/targetSelector"
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": true
    },
    "duration": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "thisBattle",
            "thisAttack",
            "thisTurn",
            "untilEndStep",
            "whileSourceExists",
            "whileConditionTrue",
            "permanent",
            "battle",
            "turn"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "sourceInstanceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "battleId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        }
      ]
    },
    "modifier": {
      "type": "object",
      "required": [
        "property"
      ],
      "properties": {
        "property": {
          "enum": [
            "bp",
            "cost",
            "symbols",
            "colors",
            "keywords"
          ]
        },
        "operation": {
          "enum": [
            "add",
            "subtract",
            "set",
            "remove"
          ]
        },
        "value": {},
        "selector": {
          "$ref": "#/$defs/targetSelector"
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": true
    }
  }
}
