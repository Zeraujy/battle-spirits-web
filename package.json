{
  "name": "battle-spirits-eternal-simulator",
  "version": "4.4.0",
  "private": true,
  "type": "module",
  "description": "Battle Spirits Eternal Simulator v4.4.0 - Web + Desktop Unified Release",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run prepare:release-config && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "npm run prepare:release-config && vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=server/.env server/index.mjs",
    "electron": "electron .",
    "electron:updater": "electron . --mode=updater",
    "build": "npm run prepare:release-config && vite build",
    "preview": "vite preview",
    "dist:win": "npm run desktop:win",
    "test": "node --test src/game/*.test.js src/online/*.test.js src/services/*.test.js",
    "verify": "node scripts/card-db/validate-catalog.mjs && node scripts/verify-project.mjs && node scripts/audit-card-images.mjs && node scripts/audit-card-thumbnails.mjs && node scripts/audit-runtime-card-references.mjs",
    "check": "npm run verify && npm test && npm run build",
    "server:start": "node --env-file-if-exists=server/.env server/index.mjs",
    "online:check": "node scripts/check-online-config.mjs",
    "verify:v3": "node scripts/verify-v3.mjs",
    "deploy:cloudflare": "npm run build && npx wrangler@4 deploy",
    "preview:cloudflare": "npm run build && npx wrangler@4 dev",
    "project:check": "npm run verify && npm test && npm run ui:audit && npm run release:audit",
    "publish:cloudflare": "npm run check && npx wrangler@4 deploy",
    "release:audit": "node scripts/release-audit.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "cards:validate": "node scripts/card-db/validate-catalog.mjs",
    "cards:sync": "node scripts/card-db/sync-catalog-manifest.mjs",
    "cards:template": "node scripts/card-db/create-set-template.mjs",
    "cards:import": "node scripts/card-db/import-set.mjs",
    "cards:check": "npm run cards:sync && npm run cards:validate && npm run verify",
    "prepare:release-config": "node scripts/generate-desktop-release-config.mjs",
    "desktop:win": "npm run build && electron-builder --win --x64",
    "desktop:mac": "npm run build && electron-builder --mac --x64 && electron-builder --mac --arm64",
    "desktop:linux": "npm run build && electron-builder --linux --x64",
    "cloudflare:preflight": "node scripts/cloudflare-asset-preflight.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.2.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.fan.battlespirits.eternal.simulator",
    "productName": "Battle Spirits",
    "artifactName": "Battle-Spirits-${os}-${arch}.${ext}",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "src/game/**/*",
      "src/data/**/*",
      "config/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config/update-config.json",
        "to": "config/update-config.json"
      },
      {
        "from": "config/desktop-release.json",
        "to": "config/desktop-release.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Battle-Spirits-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Battle Spirits",
      "uninstallDisplayName": "Battle Spirits"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "artifactName": "Battle-Spirits-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "artifactName": "Battle-Spirits-Linux-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
